[Desktop Entry]
Name=Calendar
Comment=Upcoming events in the panel
Type=Application
Exec=slate-applet
Icon=com.magnetaros.Slate
Terminal=false
Categories=COSMIC;Office;
# Marks this as a panel applet rather than something to show in the app grid.
X-CosmicApplet=true
X-CosmicHoverPopup=Auto
NoDisplay=true
