[Desktop Entry]
Name=Calendar
Comment=Upcoming events in the panel
Type=Application
Exec=cosmic-calendar-applet
Icon=io.github.entro314labs.Calendar
Terminal=false
Categories=COSMIC;
# Marks this as a panel applet rather than something to show in the app grid.
X-CosmicApplet=true
X-CosmicHoverPopup=Auto
NoDisplay=true
