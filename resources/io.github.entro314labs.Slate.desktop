[Desktop Entry]
Name=Calendar
GenericName=Calendar
Comment=View and manage your events
Categories=Office;Calendar;
Exec=cosmic-calendar %U
Icon=io.github.entro314labs.Calendar
Terminal=false
Type=Application
StartupNotify=true
StartupWMClass=io.github.entro314labs.Calendar
MimeType=text/calendar;
Keywords=calendar;event;schedule;appointment;agenda;
# Routes activations — including opening a .ics — to the running instance.
DBusActivatable=true
Actions=new-event;today;

[Desktop Action new-event]
Name=New Event
Exec=cosmic-calendar

[Desktop Action today]
Name=Today
Exec=cosmic-calendar
